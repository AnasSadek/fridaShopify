{%- comment -%}
  Star rating placeholder. Params: rating (float, default 4.8), count (int, default 128)
{%- endcomment -%}
{%- liquid
  assign rating = rating | default: 4.8
  assign count = count | default: 128
  assign full_stars = rating | round
-%}
<div class="star-rating" aria-label="{{ 'accessibility.star_reviews_info' | t: rating: rating, rating_max: 5 }}">
  {%- for i in (1..5) -%}
    {%- if i <= full_stars -%}
      {% render 'icon', name: 'star' %}
    {%- else -%}
      {% render 'icon', name: 'star-outline' %}
    {%- endif -%}
  {%- endfor -%}
  {%- if count -%}<span class="star-rating__count">({{ count }})</span>{%- endif -%}
</div>
