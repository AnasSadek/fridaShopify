<section class="section benefits" id="vorteile">
  <div class="wrap">
    <div class="section-head reveal">
      {%- if section.settings.eyebrow != blank -%}<span class="eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
      <h2>{{ section.settings.heading }}</h2>
    </div>
    <div class="ben-grid">
      {%- for block in section.blocks -%}
        <div class="ben reveal" {{ block.shopify_attributes }}>
          <div class="b-ic">{{ block.settings.icon }}</div>
          <h3>{{ block.settings.title }}</h3>
          <p>{{ block.settings.text }}</p>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>
{% schema %}
{
  "name": "Vorteile",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Deine Vorteile" },
    { "type": "text", "id": "heading", "label": "Überschrift", "default": "Warum Frida in jedes Zuhause gehört" }
  ],
  "blocks": [
    { "type": "benefit", "name": "Vorteil", "settings": [
      { "type": "text", "id": "icon", "label": "Icon (Emoji)", "default": "⏱️" },
      { "type": "text", "id": "title", "label": "Titel", "default": "Langanhaltender Duft" },
      { "type": "textarea", "id": "text", "label": "Text", "default": "Frische, die spürbar im Raum bleibt – Stunde um Stunde." }
    ] }
  ],
  "max_blocks": 6,
  "presets": [
    { "name": "Vorteile", "blocks": [
      { "type": "benefit", "settings": { "icon": "⏱️", "title": "Langanhaltender Duft", "text": "Frische, die spürbar im Raum bleibt – Stunde um Stunde." } },
      { "type": "benefit", "settings": { "icon": "🌸", "title": "Viele Duftsorten", "text": "Orientalisch, fruchtig, frisch oder blumig – für jeden Geschmack." } },
      { "type": "benefit", "settings": { "icon": "🏠", "title": "Für Zuhause & Büro", "text": "Vom Wohnzimmer bis zum Arbeitsplatz – überall einsetzbar." } },
      { "type": "benefit", "settings": { "icon": "💧", "title": "Einfache Anwendung", "text": "Sprühen oder mit Wasser mischen – schneller geht's nicht." } },
      { "type": "benefit", "settings": { "icon": "✨", "title": "Frische Atmosphäre", "text": "Ein Zuhause, das sich sauber anfühlt und angenehm duftet." } },
      { "type": "benefit", "settings": { "icon": "🧽", "title": "Ideal für den Alltag", "text": "Perfekt für die tägliche Reinigung und den täglichen Raumduft." } }
    ] }
  ]
}
{% endschema %}
