<div class="page-content">
  <h1>Mein Konto</h1>
  <p>Willkommen zurück, {{ customer.first_name }}!</p>
  <a href="{{ routes.account_logout_url }}" class="btn btn--outline">Abmelden</a>
  <h2>Meine Bestellungen</h2>
  {%- for order in customer.orders -%}
    <p><a href="{{ order.customer_url }}">{{ order.name }}</a> &middot; {{ order.created_at | date: '%d.%m.%Y' }} &middot; {{ order.total_price | money }}</p>
  {%- else -%}
    <p>Du hast noch keine Bestellungen aufgegeben.</p>
  {%- endfor -%}
</div>
