{%- assign xmas_replaces_hero = false -%}
{%- if settings.xmas_enabled and settings.xmas_hero and request.page_type == 'index' -%}{%- assign xmas_replaces_hero = true -%}{%- endif -%}
{%- unless xmas_replaces_hero -%}
{%- assign hero_product = section.settings.offer_product -%}
{%- assign hero_variant = hero_product.selected_or_first_available_variant -%}

<section class="hero hero-offer-v2">
  <div class="wrap hero-v2-grid">
    <div class="hero-copy hero-v2-copy">
      {%- if section.settings.eyebrow != blank -%}
        <span class="eyebrow hero-v2-eyebrow">{{ section.settings.eyebrow }}</span>
      {%- endif -%}

      {%- if section.settings.heading != blank -%}
        <h1 class="hero-v2-title">{{ section.settings.heading }}</h1>
      {%- endif -%}

      {%- if section.settings.deal_line != blank -%}
        <p class="hero-v2-deal">{{ section.settings.deal_line }}</p>
      {%- endif -%}

      {%- if section.settings.subheading != blank -%}
        <p class="hero-sub hero-v2-sub">{{ section.settings.subheading }}</p>
      {%- endif -%}

      {%- if hero_variant or section.settings.price_label != blank or section.settings.shipping_text != blank -%}
        <div class="hero-v2-offer-card">
          {%- if hero_variant or section.settings.price_label != blank -%}
            <div class="hero-v2-price">
              {%- if section.settings.price_prefix != blank -%}
                <span class="hero-v2-price-prefix">{{ section.settings.price_prefix }}</span>
              {%- endif -%}
              <strong class="hero-v2-price-value">
                {%- if hero_variant -%}
                  {{ hero_variant.price | money }}
                {%- else -%}
                  {{ section.settings.price_label }}
                {%- endif -%}
              </strong>
            </div>
          {%- endif -%}

          {%- if section.settings.shipping_text != blank -%}
            <div class="hero-v2-shipping">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <rect x="1" y="3" width="15" height="13" rx="2"/>
                <path d="M16 8h4l3 3v5h-7z"/>
                <circle cx="5.5" cy="18.5" r="2.5"/>
                <circle cx="18.5" cy="18.5" r="2.5"/>
              </svg>
              <span>{{ section.settings.shipping_text }}</span>
            </div>
          {%- endif -%}
        </div>
      {%- endif -%}

      <div class="hero-cta hero-v2-cta">
        {%- if section.settings.button_label != blank -%}
          <a href="{% if section.settings.button_link != blank %}{{ section.settings.button_link }}{% elsif hero_product != blank %}{{ hero_product.url }}{% else %}#{% endif %}" class="btn btn-primary">
            {{ section.settings.button_label }}
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path d="M5 12h14M13 5l7 7-7 7"/>
            </svg>
          </a>
        {%- endif -%}

        {%- if section.settings.button2_label != blank -%}
          <a href="{{ section.settings.button2_link | default: '#' }}" class="btn btn-ghost hero-v2-more">
            {{ section.settings.button2_label }}
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path d="M5 12h14M13 5l7 7-7 7"/>
            </svg>
          </a>
        {%- endif -%}
      </div>

      <div class="hero-v2-proof">
        {%- if section.settings.rating_text != blank -%}
          <span>
            <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="m12 2.5 2.9 5.9 6.5.9-4.7 4.6 1.1 6.5L12 17.3l-5.8 3.1 1.1-6.5-4.7-4.6 6.5-.9L12 2.5Z"/></svg>
            {{ section.settings.rating_text }}
          </span>
        {%- endif -%}

        {%- if section.settings.households_text != blank -%}
          <span>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
            {{ section.settings.households_text }}
          </span>
        {%- endif -%}

        {%- if section.settings.delivery_text != blank -%}
          <span>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="1" y="3" width="15" height="13" rx="2"/><path d="M16 8h4l3 3v5h-7z"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>
            {{ section.settings.delivery_text }}
          </span>
        {%- endif -%}
      </div>
    </div>

    <div class="hero-media hero-v2-media">
      {%- if section.settings.image != blank -%}
        <img
          src="{{ section.settings.image | image_url: width: 1200 }}"
          alt="{{ section.settings.image.alt | default: section.settings.heading | strip_html | escape }}"
          width="{{ section.settings.image.width }}"
          height="{{ section.settings.image.height }}"
          fetchpriority="high"
        >
      {%- else -%}
        <img
          src="{{ 'Hero.png' | asset_url }}"
          alt="Frida Lufterfrischer und Bodenfrischer Duftpaket"
          width="1690"
          height="1583"
          fetchpriority="high"
        >
      {%- endif -%}

      {%- if section.settings.offer_badge_title != blank or section.settings.offer_badge_text != blank -%}
        <div class="hero-offer-badge hero-v2-badge">
          {%- if section.settings.offer_badge_title != blank -%}
            <strong>{{ section.settings.offer_badge_title }}</strong>
          {%- endif -%}

          {%- if section.settings.offer_badge_text != blank -%}
            <span>{{ section.settings.offer_badge_text }}</span>
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>
  </div>

  {%- if section.blocks.size > 0 -%}
    <div class="hero-v2-feature-strip">
      <div class="wrap hero-v2-features">
        {%- for block in section.blocks -%}
          <span {{ block.shopify_attributes }}>
            {%- case block.settings.icon -%}
              {%- when 'drop' -%}
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M12 2.5S5 10 5 15a7 7 0 0 0 14 0c0-5-7-12.5-7-12.5Z"/></svg>
              {%- when 'flower' -%}
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="3"/><path d="M12 2v7M12 15v7M2 12h7M15 12h7M4.9 4.9l5 5M14.1 14.1l5 5M19.1 4.9l-5 5M9.9 14.1l-5 5"/></svg>
              {%- when 'truck' -%}
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="1" y="3" width="15" height="13" rx="2"/><path d="M16 8h4l3 3v5h-7z"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>
              {%- else -%}
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg>
            {%- endcase -%}
            {{ block.settings.text }}
          </span>
        {%- endfor -%}
      </div>
    </div>
  {%- endif -%}
</section>
{%- endunless -%}

{% schema %}
{
  "name": "Hero",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Sonderangebot · Nur für kurze Zeit"
    },
    {
      "type": "html",
      "id": "heading",
      "label": "Überschrift",
      "default": "Dein Zuhause duftet<br>bis zu <span class=\"g\">48 Stunden.</span>"
    },
    {
      "type": "text",
      "id": "deal_line",
      "label": "Angebotszeile",
      "default": "3 Lufterfrischer + 3 Bodenfrischer + 1 Geschenk gratis"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Untertitel",
      "default": "Stelle dein Frida Duftpaket selbst zusammen und wähle deine Lieblingsdüfte für Raum und Boden."
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Hero-Bild (leer = Standard)"
    },
    {
      "type": "header",
      "content": "Preis / Versand"
    },
    {
      "type": "product",
      "id": "offer_product",
      "label": "Produkt für dynamischen Preis"
    },
    {
      "type": "text",
      "id": "price_prefix",
      "label": "Preis-Präfix",
      "default": "Ab"
    },
    {
      "type": "text",
      "id": "price_label",
      "label": "Fallback-Preis",
      "default": "27,99 €"
    },
    {
      "type": "text",
      "id": "shipping_text",
      "label": "Versandtext",
      "default": " Versandkostenfrei"
    },
    {
      "type": "header",
      "content": "Offer badge"
    },
    {
      "type": "text",
      "id": "offer_badge_title",
      "label": "Offer badge title",
      "default": "+1"
    },
    {
      "type": "text",
      "id": "offer_badge_text",
      "label": "Offer badge text",
      "default": "Geschenk gratis"
    },
    {
      "type": "header",
      "content": "Buttons"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button 1",
      "default": "Jetzt Düfte auswählen"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Link 1"
    },
    {
      "type": "text",
      "id": "button2_label",
      "label": "Button 2",
      "default": "Mehr erfahren"
    },
    {
      "type": "url",
      "id": "button2_link",
      "label": "Link 2"
    },
    {
      "type": "header",
      "content": "Social Proof"
    },
    {
      "type": "text",
      "id": "rating_text",
      "label": "Bewertung",
      "default": "4,9/5 Bewertung"
    },
    {
      "type": "text",
      "id": "households_text",
      "label": "Haushalte",
      "default": "12.000+ zufriedene Haushalte"
    },
    {
      "type": "text",
      "id": "delivery_text",
      "label": "Lieferung",
      "default": "2–4 Tage Lieferung"
    }
  ],
  "blocks": [
    {
      "type": "badge",
      "name": "Feature",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "default": "clock",
          "options": [
            { "value": "clock", "label": "Uhr" },
            { "value": "drop", "label": "Tropfen" },
            { "value": "flower", "label": "Blume" },
            { "value": "truck", "label": "Truck" }
          ]
        },
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Bis zu 48h Duft"
        }
      ]
    }
  ],
  "max_blocks": 5,
  "presets": [
    {
      "name": "Hero",
      "blocks": [
        {
          "type": "badge",
          "settings": {
            "icon": "clock",
            "text": "Bis zu 48h Duft"
          }
        },
        {
          "type": "badge",
          "settings": {
            "icon": "drop",
            "text": "Hochkonzentriert"
          }
        },
        {
          "type": "badge",
          "settings": {
            "icon": "flower",
            "text": "7+ Düfte"
          }
        },
        {
          "type": "badge",
          "settings": {
            "icon": "truck",
            "text": "Schneller Versand"
          }
        }
      ]
    }
  ]
}
{% endschema %}
