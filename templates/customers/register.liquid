<div class="page-content" style="max-width:420px">
  <h1>Konto erstellen</h1>
  {% form 'create_customer' %}
    {{ form.errors | default_errors }}
    <div style="display:flex;flex-direction:column;gap:12px">
      <input type="text" name="customer[first_name]" placeholder="Vorname" autocomplete="given-name">
      <input type="text" name="customer[last_name]" placeholder="Nachname" autocomplete="family-name">
      <input type="email" name="customer[email]" placeholder="E-Mail" autocomplete="email" required>
      <input type="password" name="customer[password]" placeholder="Passwort" autocomplete="new-password" required>
      <button type="submit" class="btn btn--primary btn--full">Konto erstellen</button>
    </div>
  {% endform %}
  <p style="margin-top:16px"><a href="{{ routes.account_login_url }}">Bereits ein Konto? Anmelden</a></p>
</div>
