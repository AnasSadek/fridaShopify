<section class="section"><div class="wrap" style="max-width:760px">
  <div class="section-head reveal"><h2>{{ article.title }}</h2><p>{{ article.published_at | date: '%d.%m.%Y' }}</p></div>
  {%- if article.image -%}<img src="{{ article.image | image_url: width: 1200 }}" alt="{{ article.image.alt | default: article.title | escape }}" width="{{ article.image.width | at_most: 1200 }}" height="{{ article.image.width | at_most: 1200 | divided_by: article.image.aspect_ratio | round }}" style="border-radius:var(--r-lg);margin-bottom:24px">{%- endif -%}
  <div class="rte">{{ article.content }}</div>
</div></section>
{% schema %}{ "name": "Artikel" }{% endschema %}
