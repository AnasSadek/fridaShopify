<div class="page-width section-padding">
  <div class="section-header">
    <h1 class="section-title">{{ collection.title }}</h1>
    {%- if collection.description != blank -%}
      <div class="section-subtitle">{{ collection.description }}</div>
    {%- endif -%}
  </div>

  {%- paginate collection.products by 24 -%}
    <div class="product-grid">
      {%- for product in collection.products -%}
        {% render 'product-card', product: product %}
      {%- else -%}
        <p>{{ 'general.search.no_results' | t: terms: collection.title }}</p>
      {%- endfor -%}
    </div>

    {%- if paginate.pages > 1 -%}
      <nav class="pagination text-center" style="margin-top:32px" aria-label="Pagination">
        {{ paginate | default_pagination }}
      </nav>
    {%- endif -%}
  {%- endpaginate -%}
</div>

{% schema %}
{
  "name": "Kollektion"
}
{% endschema %}
