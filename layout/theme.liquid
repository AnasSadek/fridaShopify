<!doctype html>
{%- assign iso_code = request.locale.iso_code | downcase -%}
{%- assign lang_root = iso_code | split: '-' | first -%}
{%- assign rtl_languages = 'ar,fa,he,ur' | split: ',' -%}
{%- assign text_direction = 'ltr' -%}
{%- if rtl_languages contains lang_root -%}{%- assign text_direction = 'rtl' -%}{%- endif -%}
<html lang="{{ iso_code }}" dir="{{ text_direction }}" class="no-js{% if text_direction == 'rtl' %} rtl{% endif %}">
<head>
  <link rel="icon" type="image/png" href="https://cdn.shopify.com/s/files/1/0955/3700/4924/files/favicon.png">
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta http-equiv="X-UA-Compatible" content="IE=edge">
  <link rel="canonical" href="{{ canonical_url }}">
  {%- if settings.favicon != blank -%}
    <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
  {%- endif -%}

  <title>{{ page_title }}{% if current_tags %} &ndash; {{ 'general.meta.tagged' | t }} "{{ current_tags | join: ', ' }}"{% endif %}{% if current_page != 1 %} &ndash; {{ 'general.meta.page' | t }} {{ current_page }}{% endif %}{% unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless %}</title>
  {%- if page_description -%}<meta name="description" content="{{ page_description | escape }}">{%- endif -%}
  {%- render 'meta-social' -%}

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,400;12..96,500;12..96,600;12..96,700;12..96,800&family=Inter:wght@400;500;600;700&family=Cairo:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  {{ 'frida-theme.css' | asset_url | stylesheet_tag }}
  {%- if settings.xmas_enabled -%}
    {{ 'frida-xmas.css' | asset_url | stylesheet_tag }}
  {%- endif -%}

  <script>document.documentElement.className = document.documentElement.className.replace('no-js','js');</script>
  {{ content_for_header }}
</head>

<body class="template-{{ request.page_type | handle }} lang-{{ lang_root }} dir-{{ text_direction }}{% unless settings.enable_animations %} anim-off{% endunless %}{% if settings.xmas_enabled %} skin-xmas{% if settings.xmas_lights %} xmas-lights-on{% endif %}{% endif %}">
  {% section 'announcement-bar' %}
  {% section 'header' %}

  <main id="MainContent" role="main">
    {{ content_for_layout }}
  </main>

  {% section 'footer' %}

  {%- render 'cart-drawer' -%}
  {%- render 'quick-view' -%}

  <!-- TOAST -->
  <div class="toast" id="toast"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 13l4 4L19 7"/></svg><span id="toastMsg">{{ 'cart.general.added' | t }}</span></div>

  <script>
    window.fridaRoutes = {{ routes | json }};
    window.fridaLocale = { code: {{ iso_code | json }}, direction: {{ text_direction | json }} };
    window.fridaStrings = {
      added: {{ 'cart.general.added' | t | json }},
      cartEmpty: {{ 'cart.general.empty' | t | json }},
      remove: {{ 'cart.general.remove' | t | json }},
      freeShippingDone: {{ 'cart.general.free_shipping_done_html' | t | json }},
      freeShippingRemaining: {{ 'cart.general.free_shipping_remaining_html' | t | json }},
      upsellTitle: {{ 'cart.general.upsell_title' | t | json }},
      upsellAdd: {{ 'cart.general.upsell_add' | t | json }},
      addError: {{ 'cart.general.add_error' | t | json }},
      inStock: {{ 'products.product.in_stock' | t | json }},
      soldOut: {{ 'products.product.sold_out' | t | json }},
      addToCart: {{ 'products.product.add_to_cart' | t | json }},
      close: {{ 'general.accessibility.close' | t | json }},
      homeFragrance: {{ 'products.product.home_fragrance' | t | json }},
      allDetails: {{ 'products.product.all_details' | t | json }},
      option: {{ 'products.product.option' | t | json }},
      videoComingSoon: {{ 'video.coming_soon' | t | json }}
    };
    window.fridaCartStrings = { added: window.fridaStrings.added, empty: window.fridaStrings.cartEmpty };
    //window.fridaSettings = { freeShip: {{ settings.free_shipping_threshold | default: 55 | times: 100 }} };
    window.fridaSettings = {
      freeShip: 5500
    };
  </script>
  <script src="{{ 'frida-theme.js' | asset_url }}" defer></script>
  {%- if settings.xmas_enabled -%}
    {%- comment -%}
      Weihnachts-Skin: Produkt (Handle der Standardsprache) und Varianten-ID des Weihnachtsdufts.
      Die ID statt des Namens, weil Variantennamen und Handles je Sprache übersetzt sind.
    {%- endcomment -%}
    {%- assign xmas_product = all_products['frida-air-freshener-460ml'] -%}
    <script>
      window.fridaXmas = {
        url: {{ xmas_product.url | json }},
        variantId: 58172908601724,
        img: {{ 'xmas-vanilla-cinnamon.webp' | asset_url | json }},
        strings: {
          eyebrow: {{ 'xmas.eyebrow' | t | json }},
          sub: {{ 'xmas.sub' | t | json }},
          seal_title: {{ 'xmas.seal_title' | t | json }},
          seal_text: {{ 'xmas.seal_text' | t | json }},
          note_vanilla: {{ 'xmas.note_vanilla' | t | json }},
          note_cinnamon: {{ 'xmas.note_cinnamon' | t | json }}
        }
      };
    </script>
    <script src="{{ 'frida-xmas.js' | asset_url }}" defer></script>
  {%- endif -%}
</body>
</html>
