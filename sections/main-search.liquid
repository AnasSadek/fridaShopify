<section class="section">
  <div class="wrap">
    <div class="section-head reveal"><h2>{{ 'general.search.title' | t }}</h2></div>
    <form action="{{ routes.search_url }}" method="get" class="news-form" style="margin-bottom:30px">
      <input type="search" name="q" value="{{ search.terms | escape }}" placeholder="{{ 'general.search.input_placeholder' | t }}" aria-label="{{ 'general.accessibility.search' | t }}">
      <button type="submit" class="btn btn-primary">{{ 'general.search.search' | t }}</button>
    </form>
    {%- if search.performed -%}
      <div class="grid-prod">
        {%- for item in search.results -%}
          {%- if item.object_type == 'product' -%}{%- render 'product-card', card: item -%}{%- endif -%}
        {%- else -%}<p>{{ 'general.search.no_results_html' | t: terms: search.terms }}</p>{%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</section>
{% schema %}{ "name": "Suche" }{% endschema %}
