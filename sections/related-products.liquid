<section class="section-padding" data-product-recommendations data-url="{{ routes.product_recommendations_url }}?section_id={{ section.id }}&product_id={{ product.id }}&limit={{ section.settings.products_to_show }}&intent=related">
  <div class="page-width">
    <div class="section-header">
      <h2 class="section-title">{{ 'products.product.related_title' | t }}</h2>
    </div>
    <div class="product-grid" data-product-recommendations-target>
      {%- if recommendations.performed and recommendations.products_count > 0 -%}
        {%- for product in recommendations.products -%}
          {% render 'product-card', product: product %}
        {%- endfor -%}
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Ähnliche Produkte",
  "settings": [
    { "type": "range", "id": "products_to_show", "label": "Anzahl Produkte", "min": 4, "max": 8, "step": 4, "default": 4 }
  ]
}
{% endschema %}
