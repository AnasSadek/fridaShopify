<section class="section-padding" id="kategorien">
  <div class="page-width">
    <div class="section-header">
      {%- if section.settings.eyebrow != blank -%}<p class="section-eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
      <h2 class="section-title">{{ section.settings.title | default: 'Finde deinen Frida Favoriten' }}</h2>
      <p class="section-subtitle">{{ section.settings.subtitle }}</p>
    </div>

    <div class="category-grid">
      {%- for block in section.blocks -%}
        <a href="{{ block.settings.link | default: '#' }}" class="category-card" {{ block.shopify_attributes }}>
          <div class="category-card__media">
            {%- if block.settings.image -%}
              <img src="{{ block.settings.image | image_url: width: 800 }}" alt="{{ block.settings.image.alt | default: block.settings.title | escape }}" loading="lazy" width="800" height="1000">
            {%- else -%}
              {{ 'product-2' | placeholder_svg_tag: 'category-card__placeholder' }}
            {%- endif -%}
          </div>
          <div class="category-card__body">
            <h3 class="category-card__title">{{ block.settings.title }}</h3>
            <p class="category-card__text">{{ block.settings.text }}</p>
            <span class="btn btn--outline btn--sm">{{ block.settings.cta_text | default: 'Entdecken' }}</span>
          </div>
        </a>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Frida Kategorien",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Kicker-Text",
      "default": "Unsere Produktwelten"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Überschrift",
      "default": "Finde deinen Frida Favoriten"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Untertitel",
      "default": "Von Lufterfrischer bis Bodenduft – für jeden Raum die passende Frische."
    }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Kategorie",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Bild" },
        { "type": "text", "id": "title", "label": "Titel", "default": "Luftdüfte" },
        { "type": "textarea", "id": "text", "label": "Beschreibung", "default": "Sprühe frische Duftmomente direkt in die Luft – für jeden Raum." },
        { "type": "text", "id": "cta_text", "label": "Button-Text", "default": "Jetzt entdecken" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "Frida Kategorien",
      "blocks": [
        { "type": "category", "settings": { "title": "Luftdüfte", "text": "Sprühe frische Duftmomente direkt in die Luft – für jeden Raum, jederzeit.", "cta_text": "Luftdüfte entdecken" } },
        { "type": "category", "settings": { "title": "Bodendüfte", "text": "Mit Wasser mischen und Böden sowie Oberflächen strahlend frisch reinigen.", "cta_text": "Bodendüfte entdecken" } },
        { "type": "category", "settings": { "title": "Duft-Bundles", "text": "Mehrere Frida Lieblinge im Set – mehr Duft, mehr sparen.", "cta_text": "Bundles ansehen" } }
      ]
    }
  ]
}
{% endschema %}
