{%- comment -%}
  Promo-Badge: gibt den Namen der passenden Rabatt-Kampagne aus (oder nichts).

  Erwartet: pb_product (product)

  Datenquelle: Shop-Metafeld frida.promo_badges (Typ JSON), editierbar unter
  Shopify Admin -> Einstellungen -> Benutzerdefinierte Daten -> Shop.
  Es wird aus den automatischen Shopify-Rabatten synchronisiert (Admin API);
  Start/Ende und Land werden hier LIVE bei jedem Seitenaufruf geprüft:
  - starts/ends: Unix-Sekunden (ends 0 = kein Enddatum). Abgelaufene oder noch
    nicht gestartete Kampagnen zeigen nie ein Badge, auch ohne neue Synchronisation.
  - countries: ISO-Ländercodes der Markets (leer = alle Länder). Verglichen wird
    das tatsächlich gewählte Lieferland (localization.country), nicht die Sprache.
  - Produktbezug: all (alle Produkte) / product_handles / collection_handles.
    Die Liste ist nach Spezifität sortiert; der erste Treffer gewinnt.
  Nur Umbenennungen, neue oder anders ausgerichtete Kampagnen brauchen eine
  erneute Synchronisation bzw. eine manuelle Anpassung des Metafelds.
{%- endcomment -%}
{%- liquid
  assign pb_title = blank
  if settings.promo_badges_enabled and pb_product != blank
    assign pb_data = shop.metafields.frida.promo_badges.value
    if pb_data != blank and pb_data.campaigns != blank
      assign pb_now = 'now' | date: '%s' | plus: 0
      assign pb_country = localization.country.iso_code
      for pb_c in pb_data.campaigns
        assign pb_starts = pb_c.starts | default: 0 | plus: 0
        assign pb_ends = pb_c.ends | default: 0 | plus: 0
        if pb_starts > pb_now
          continue
        endif
        if pb_ends > 0 and pb_ends < pb_now
          continue
        endif
        if pb_c.countries.size > 0
          unless pb_c.countries contains pb_country
            continue
          endunless
        endif
        assign pb_match = false
        if pb_c.all == true
          assign pb_match = true
        endif
        if pb_match == false and pb_c.product_handles.size > 0
          if pb_c.product_handles contains pb_product.handle
            assign pb_match = true
          endif
        endif
        if pb_match == false and pb_c.collection_handles.size > 0
          for pb_col in pb_product.collections
            if pb_c.collection_handles contains pb_col.handle
              assign pb_match = true
              break
            endif
          endfor
        endif
        if pb_match
          assign pb_title = pb_c.title | strip
          break
        endif
      endfor
    endif
  endif
-%}
{%- if pb_title != blank -%}{{ pb_title }}{%- endif -%}
