<div class="page-content" style="max-width:420px">
  <h1>Anmelden</h1>
  {% form 'customer_login' %}
    {{ form.errors | default_errors }}
    <div style="display:flex;flex-direction:column;gap:12px">
      <input type="email" name="customer[email]" placeholder="E-Mail" autocomplete="email" required>
      <input type="password" name="customer[password]" placeholder="Passwort" autocomplete="current-password" required>
      <button type="submit" class="btn btn--primary btn--full">Anmelden</button>
    </div>
  {% endform %}
  <p style="margin-top:16px"><a href="{{ routes.account_register_url }}">Noch kein Konto? Jetzt registrieren</a></p>
</div>
