{%- comment -%} SEO: Open Graph, Twitter Card, JSON-LD structured data {%- endcomment -%}
<meta property="og:site_name" content="Frida EU">
<meta property="og:url" content="{{ canonical_url }}">
<meta property="og:title" content="{{ page_title | escape }}">
{% if page_description %}<meta property="og:description" content="{{ page_description | escape }}">{% endif %}
<meta property="og:type" content="{% if template contains 'product' %}og:product{% else %}website{% endif %}">
{% if page_image %}
  <meta property="og:image" content="http:{{ page_image | image_url: width: 1200 }}">
  <meta property="og:image:width" content="1200">
{% endif %}
<meta name="twitter:card" content="summary_large_image">

{%- if template contains 'product' -%}
  <script type="application/ld+json">
  {
    "@context": "https://schema.org/",
    "@type": "Product",
    "name": {{ product.title | json }},
    "description": {{ product.description | strip_html | truncate: 300 | json }},
    "sku": {{ product.selected_or_first_available_variant.sku | json }},
    "brand": { "@type": "Brand", "name": "Frida EU" },
    {% if product.featured_image %}"image": "https:{{ product.featured_image | image_url: width: 1200 }}",{% endif %}
    "offers": {
      "@type": "Offer",
      "url": {{ shop.url | append: product.url | json }},
      "priceCurrency": {{ cart.currency.iso_code | json }},
      "price": {{ product.selected_or_first_available_variant.price | money_without_currency | strip_html | json }},
      "availability": "https://schema.org/{% if product.selected_or_first_available_variant.available %}InStock{% else %}OutOfStock{% endif %}"
    }
  }
  </script>
{%- endif -%}

{%- unless template contains 'product' -%}
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Organization",
    "name": "Frida EU",
    "url": {{ shop.url | json }},
    "sameAs": [
      {% if settings.social_instagram_link != blank %}{{ settings.social_instagram_link | json }},{% endif %}
      {% if settings.social_tiktok_link != blank %}{{ settings.social_tiktok_link | json }},{% endif %}
      {% if settings.social_facebook_link != blank %}{{ settings.social_facebook_link | json }}{% endif %}
    ]
  }
  </script>
{%- endunless -%}
