<section class="section-padding" style="background:var(--color-bg-soft)">
  <div class="page-width">
    <div class="section-header">
      {%- if section.settings.eyebrow != blank -%}<p class="section-eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
      <h2 class="section-title">{{ section.settings.title | default: 'Das sagen unsere Kund:innen' }}</h2>
    </div>

    <div class="testimonial-grid">
      {%- for block in section.blocks -%}
        <div class="testimonial-card" {{ block.shopify_attributes }}>
          {% render 'star-rating', rating: block.settings.rating, count: false %}
          <p>&bdquo;{{ block.settings.quote }}&ldquo;</p>
          <div class="testimonial-card__author">
            <span class="testimonial-card__avatar">{{ block.settings.name | slice: 0 }}</span>
            <div>
              <p class="testimonial-card__name">{{ block.settings.name }}</p>
              <p class="testimonial-card__meta">{{ block.settings.meta }}</p>
            </div>
          </div>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Frida Bewertungen",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Kicker-Text", "default": "Social Proof" },
    { "type": "text", "id": "title", "label": "Überschrift", "default": "Das sagen unsere Kund:innen" }
  ],
  "blocks": [
    {
      "type": "testimonial",
      "name": "Bewertung",
      "settings": [
        { "type": "range", "id": "rating", "label": "Sterne", "min": 1, "max": 5, "step": 1, "default": 5 },
        { "type": "textarea", "id": "quote", "label": "Zitat", "default": "Riecht unglaublich frisch und hält lange." },
        { "type": "text", "id": "name", "label": "Name", "default": "Julia M." },
        { "type": "text", "id": "meta", "label": "Zusatzinfo", "default": "Verifizierter Kauf" }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "Frida Bewertungen",
      "blocks": [
        { "type": "testimonial", "settings": { "rating": 5, "quote": "Riecht unglaublich frisch und hält lange.", "name": "Julia M.", "meta": "Verifizierter Kauf" } },
        { "type": "testimonial", "settings": { "rating": 5, "quote": "Mein Zuhause fühlt sich direkt sauberer an.", "name": "Sabine K.", "meta": "Verifizierter Kauf" } },
        { "type": "testimonial", "settings": { "rating": 5, "quote": "Ich liebe die verschiedenen Duftsorten.", "name": "Anna T.", "meta": "Verifizierter Kauf" } }
      ]
    }
  ]
}
{% endschema %}
