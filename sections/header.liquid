<header id="header">
  <div class="wrap nav">
    <a class="brand" href="{{ routes.root_url }}" aria-label="{{ shop.name }} {{ 'general.navigation.home' | t }}">
      {%- if section.settings.logo != blank -%}
        <img src="{{ section.settings.logo | image_url: width: 240 }}" alt="{{ shop.name }}" height="60" width="120">
      {%- else -%}
        <img src="{{ 'logo.webp' | asset_url }}" alt="{{ shop.name }}" width="60" height="30">
      {%- endif -%}
    </a>
    <nav class="nav-links" aria-label="{{ 'general.accessibility.menu' | t }}">
      {%- for link in linklists[section.settings.menu].links -%}
        <a href="{{ link.url }}">{{ link.title }}</a>
      {%- else -%}
        <a href="{{ routes.all_products_collection_url }}">{{ 'general.navigation.products' | t }}</a>
        <a href="{{ routes.all_products_collection_url }}">{{ 'general.navigation.bestseller' | t }}</a>
      {%- endfor -%}
      {%- if section.settings.show_new_link -%}
        {%- liquid
          assign hdr_new_url = section.settings.new_link
          if hdr_new_url == blank
            assign hdr_new_url = collections['neu'].url
          endif
          if hdr_new_url == blank
            assign hdr_new_url = routes.all_products_collection_url
          endif
        -%}
        <a href="{{ hdr_new_url }}" class="nav-seasonal nav-seasonal-new">
          {%- if section.settings.new_link_label != blank -%}{{ section.settings.new_link_label }}{%- else -%}{{ 'general.navigation.new' | t }}{%- endif -%}
        </a>
      {%- endif -%}
      {%- if section.settings.show_holiday_link -%}
        {%- liquid
          assign hdr_holiday_url = section.settings.holiday_link
          if hdr_holiday_url == blank
            assign hdr_holiday_url = routes.root_url | append: '#weihnachten'
          endif
        -%}
        <a href="{{ hdr_holiday_url }}" class="nav-seasonal nav-seasonal-holiday">
          <span class="nav-snow" aria-hidden="true">❄</span>
          {%- if section.settings.holiday_link_label != blank -%}{{ section.settings.holiday_link_label }}{%- else -%}{{ 'general.navigation.holiday' | t }}{%- endif -%}
        </a>
      {%- endif -%}
    </nav>
    <div class="nav-actions">
      {%- render 'language-switcher', form_id: 'HeaderLanguageForm' -%}
      {% comment %} <a class="icon-btn" href="{{ routes.search_url }}" aria-label="{{ 'general.accessibility.search' | t }}">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="7"/><path d="m21 21-4.3-4.3"/></svg>
      </a> {% endcomment %}
      {%- if shop.customer_accounts_enabled -%}
        <a
          href="{{ routes.account_url }}"
          class="header-account icon-btn"
          rel="nofollow"
          aria-label="{{ 'customer.account.title' | t }}"
        >
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M20 21a8 8 0 0 0-16 0"/>
            <circle cx="12" cy="7" r="4"/>
          </svg>
        </a>
      {%- endif -%}
      <button class="icon-btn" id="cartBtn" aria-label="{{ 'general.accessibility.cart_open' | t }}">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4Z"/><path d="M3 6h18"/><path d="M16 10a4 4 0 0 1-8 0"/></svg>
        <span class="cart-count" id="cartCount">{{ cart.item_count }}</span>
      </button>
      <button class="icon-btn burger" id="burger" aria-label="{{ 'general.accessibility.menu' | t }}">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 6h16M4 12h16M4 18h16"/></svg>
      </button>
    </div>
  </div>
</header>
{% schema %}
{
  "name": "Kopfzeile",
  "settings": [
    { "type": "image_picker", "id": "logo", "label": "Logo (leer = Frida-Standardlogo)" },
    { "type": "link_list", "id": "menu", "label": "Navigationsmenü", "default": "main-menu" },
    { "type": "header", "content": "Saisonale Navigation" },
    { "type": "paragraph", "content": "Optionale Links für Kampagnen (z. B. Neuheiten oder Weihnachtswelt). Nach der Saison einfach deaktivieren – die normale Navigation bleibt unverändert." },
    { "type": "checkbox", "id": "show_new_link", "label": "„Neu“-Link anzeigen", "default": false },
    { "type": "text", "id": "new_link_label", "label": "„Neu“-Beschriftung (leer = übersetzt „Neu“)" },
    { "type": "url", "id": "new_link", "label": "„Neu“-Ziel (leer = Collection „neu“)" },
    { "type": "checkbox", "id": "show_holiday_link", "label": "„Weihnachtswelt“-Link anzeigen", "default": false },
    { "type": "text", "id": "holiday_link_label", "label": "„Weihnachtswelt“-Beschriftung (leer = übersetzt)" },
    { "type": "url", "id": "holiday_link", "label": "„Weihnachtswelt“-Ziel (leer = Weihnachts-Hero auf der Startseite)" }
  ]
}
{% endschema %}
