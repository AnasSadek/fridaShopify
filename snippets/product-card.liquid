{%- comment -%} Erwartet: card (product) {%- endcomment -%}

{%- assign has_variants = false -%}
{%- if card.variants.size > 1 -%}
  {%- assign has_variants = true -%}
{%- endif -%}

{%- assign product_url = card.url -%}
{%- assign fallback_product_type = 'products.product.home_fragrance' | t -%}
{%- assign shipping_included = card.metafields.custom.shipping_included.value -%}

{%- assign is_mix_match_product = false -%}
{%- assign card_handle_downcase = card.handle | downcase -%}
{%- assign card_title_downcase = card.title | downcase -%}
{%- if card_handle_downcase contains 'mix-match'
  or card_handle_downcase contains 'duftpaket-7-dufte-selbst-wahlen'
  or card_title_downcase contains 'mix & match'
  or card_title_downcase contains 'mix and match'
-%}
  {%- assign is_mix_match_product = true -%}
{%- endif -%}

<article class="card reveal" data-product-card>
  <div class="card-media">
    {%- capture promo_title -%}{%- render 'promo-badge', pb_product: card -%}{%- endcapture -%}
    {%- assign promo_title = promo_title | strip -%}
    {%- assign has_main_badge = false -%}
    {%- if promo_title != blank -%}
      {%- assign has_main_badge = true -%}
      <span class="badge badge-promo" dir="auto" title="{{ promo_title | escape }}">{{ promo_title }}</span>
    {%- elsif card.compare_at_price > card.price -%}
      {%- assign has_main_badge = true -%}
      <span class="badge sale">{{ 'products.product.sale' | t }}</span>
    {%- elsif card.tags contains 'Neu' -%}
      {%- assign has_main_badge = true -%}
      <span class="badge">{{ 'products.product.new' | t }}</span>
    {%- elsif card.tags contains 'Bestseller' -%}
      {%- assign has_main_badge = true -%}
      <span class="badge">{{ 'products.product.bestseller' | t }}</span>
    {%- elsif has_variants -%}
      {%- assign has_main_badge = true -%}
      <span class="badge">{{ 'products.product.popular' | t }}</span>
    {%- endif -%}

    {%- if shipping_included == true -%}
      <span class="badge badge-shipping-included{% unless has_main_badge %} badge-shipping-alone{% endunless %}">
        {{ 'products.product.free_shipping_badge' | t }}
      </span>
    {%- endif -%}

    <a href="{{ product_url }}" aria-label="{{ card.title | escape }}">
      {%- if card.featured_image -%}
        <img
          src="{{ card.featured_image | image_url: width: 600 }}"
          alt="{{ card.featured_image.alt | default: card.title | escape }}"
          width="600"
          height="600"
          loading="lazy"
        >
      {%- else -%}
        {{ 'product-1' | placeholder_svg_tag }}
      {%- endif -%}
    </a>

    {%- if is_mix_match_product -%}
      <a href="{{ product_url }}" class="quick">
        {{ 'products.product.choose_scent' | t }}
      </a>
    {%- else -%}
      <button
        type="button"
        class="quick"
        data-quick-view="{{ card.handle }}"
        data-product-url="{{ product_url }}"
        data-shipping-included="{% if shipping_included == true %}true{% else %}false{% endif %}"
      >
        {{ 'products.product.quick_view' | t }}
      </button>
    {%- endif -%}
  </div>

  <div class="card-body">
    {% comment %} <div class="card-cat">{{ card.type | default: fallback_product_type }}</div> {% endcomment %}

    <a href="{{ product_url }}" class="card-name">
      {{ card.title }}
    </a>

    <div class="card-scent">
      {%- if card.metafields.custom.scent != blank -%}
        {{ card.metafields.custom.scent }}
      {%- elsif has_variants -%}
        {{ 'products.product.scents_count' | t: count: card.variants.size }}
      {%- else -%}
        {{ card.variants.first.title | remove: 'Default Title' }}
      {%- endif -%}
    </div>

    {%- render 'frida-rating', product: card -%}

    <div class="price-row">
      <span class="price">
        {% if has_variants and card.price_varies %}{{ 'products.product.from' | t }} {% endif %}{{ card.price | money }}
      </span>

      {%- if card.compare_at_price > card.price -%}
        <span class="price-old">{{ card.compare_at_price | money }}</span>
      {%- endif -%}
    </div>

    {%- if is_mix_match_product -%}
      {%- if card.available -%}
        <a href="{{ product_url }}" class="add-btn">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M12 3c2.7 3.3 5 6.4 5 9.5a5 5 0 0 1-10 0C7 9.4 9.3 6.3 12 3Z"/>
          </svg>
          {{ 'products.product.choose_scent' | t }}
        </a>
      {%- else -%}
        <button type="button" class="add-btn" disabled>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4Z"/>
            <path d="M3 6h18"/>
            <path d="M16 10a4 4 0 0 1-8 0"/>
          </svg>
          {{ 'products.product.sold_out' | t }}
        </button>
      {%- endif -%}
    {%- elsif has_variants -%}
      <button
        type="button"
        class="add-btn"
        data-quick-view="{{ card.handle }}"
        data-product-url="{{ product_url }}"
        data-shipping-included="{% if shipping_included == true %}true{% else %}false{% endif %}"
        {% unless card.available %}disabled{% endunless %}
      >
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M12 3c2.7 3.3 5 6.4 5 9.5a5 5 0 0 1-10 0C7 9.4 9.3 6.3 12 3Z"/>
        </svg>
        {% if card.available %}{{ 'products.product.choose_scent' | t }}{% else %}{{ 'products.product.sold_out' | t }}{% endif %}
      </button>
    {%- else -%}
      {%- form 'product', card, class: 'frida-add-form' -%}
        <input type="hidden" name="id" value="{{ card.selected_or_first_available_variant.id }}">
        {%- if shipping_included == true -%}
          <input type="hidden" name="properties[_shipping_included]" value="true">
        {%- endif -%}

        <button type="submit" class="add-btn" {% unless card.available %}disabled{% endunless %}>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4Z"/>
            <path d="M3 6h18"/>
            <path d="M16 10a4 4 0 0 1-8 0"/>
          </svg>
          {% if card.available %}{{ 'products.product.add_to_cart' | t }}{% else %}{{ 'products.product.sold_out' | t }}{% endif %}
        </button>
      {%- endform -%}
    {%- endif -%}
  </div>
</article>