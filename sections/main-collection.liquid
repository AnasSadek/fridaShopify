<section class="section">
  <div class="wrap">
    <div class="section-head reveal">
      <span class="eyebrow">Kollektion</span>
      <h2>{{ collection.title }}</h2>
      {%- if collection.description != blank -%}<p>{{ collection.description | strip_html | truncatewords: 40 }}</p>{%- endif -%}
    </div>
    <div class="grid-prod">
      {%- for product in collection.products -%}
        {%- render 'product-card', card: product -%}
      {%- else -%}
        <p>Keine Produkte in dieser Kollektion.</p>
      {%- endfor -%}
    </div>
    {%- if paginate.pages > 1 -%}
      <div style="text-align:center;margin-top:40px" class="frida-pagination">{{ paginate | default_pagination }}</div>
    {%- endif -%}
  </div>
</section>
{% schema %}
{ "name": "Kollektion", "settings": [ { "type": "range", "id": "per_page", "label": "Produkte pro Seite", "min": 4, "max": 24, "step": 4, "default": 12 } ] }
{% endschema %}
