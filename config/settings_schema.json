[
  {
    "name": "theme_info",
    "theme_name": "Frida EU",
    "theme_version": "1.0.0",
    "theme_author": "Frida EU",
    "theme_documentation_url": "https://frida-eu.example",
    "theme_support_url": "https://frida-eu.example/pages/kontakt"
  },
  {
    "name": "Farben",
    "settings": [
      {
        "type": "header",
        "content": "Markenfarben"
      },
      {
        "type": "color",
        "id": "color_primary",
        "label": "Frida Blau (Primär)",
        "default": "#0B5D8C"
      },
      {
        "type": "color",
        "id": "color_primary_dark",
        "label": "Frida Blau Dunkel",
        "default": "#083F60"
      },
      {
        "type": "color",
        "id": "color_aqua",
        "label": "Aqua Akzent",
        "default": "#4FD1CE"
      },
      {
        "type": "color",
        "id": "color_aqua_light",
        "label": "Aqua Hell (Flächen)",
        "default": "#EAFBFA"
      },
      {
        "type": "color",
        "id": "color_background",
        "label": "Hintergrund",
        "default": "#FFFFFF"
      },
      {
        "type": "color",
        "id": "color_background_soft",
        "label": "Hintergrund Soft",
        "default": "#F5FAFB"
      },
      {
        "type": "color",
        "id": "color_text",
        "label": "Textfarbe",
        "default": "#0F2733"
      },
      {
        "type": "color",
        "id": "color_text_light",
        "label": "Textfarbe Hell",
        "default": "#54707C"
      }
    ]
  },
  {
    "name": "Typografie",
    "settings": [
      {
        "type": "font_picker",
        "id": "font_heading",
        "label": "Schriftart Überschriften",
        "default": "assistant_n4"
      },
      {
        "type": "font_picker",
        "id": "font_body",
        "label": "Schriftart Fließtext",
        "default": "assistant_n4"
      }
    ]
  },
  {
    "name": "Layout",
    "settings": [
      {
        "type": "range",
        "id": "page_width",
        "label": "Seitenbreite",
        "min": 1000,
        "max": 1600,
        "step": 50,
        "unit": "px",
        "default": 1300
      },
      {
        "type": "range",
        "id": "corner_radius",
        "label": "Eckenradius (Karten/Buttons)",
        "min": 0,
        "max": 24,
        "step": 2,
        "unit": "px",
        "default": 16
      }
    ]
  },
  {
    "name": "Favicon",
    "settings": [
      {
        "type": "image_picker",
        "id": "favicon",
        "label": "Favicon Bild",
        "info": "64 x 64px empfohlen"
      }
    ]
  },
  {
    "name": "Social Media",
    "settings": [
      {
        "type": "header",
        "content": "Social Media Links"
      },
      {
        "type": "text",
        "id": "social_instagram_link",
        "label": "Instagram URL"
      },
      {
        "type": "text",
        "id": "social_tiktok_link",
        "label": "TikTok URL"
      },
      {
        "type": "text",
        "id": "social_facebook_link",
        "label": "Facebook URL"
      },
      {
        "type": "text",
        "id": "social_pinterest_link",
        "label": "Pinterest URL"
      }
    ]
  },
  {
    "name": "Warenkorb",
    "settings": [
      {
        "type": "select",
        "id": "cart_type",
        "label": "Warenkorb-Typ",
        "options": [
          { "value": "drawer", "label": "Drawer (seitlich)" },
          { "value": "page", "label": "Warenkorb-Seite" }
        ],
        "default": "drawer"
      },
      {
        "type": "checkbox",
        "id": "show_cart_note",
        "label": "Bestellnotiz im Warenkorb erlauben",
        "default": true
      }
    ]
  }
]
