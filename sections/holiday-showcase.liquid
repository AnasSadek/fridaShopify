{%- liquid
  assign sc_product = all_products[section.settings.product]
  assign sc_variant = blank
  if sc_product != blank
    assign sc_variant = sc_product.selected_or_first_available_variant
    if section.settings.variant_id != blank
      for v in sc_product.variants
        assign vid = v.id | append: ''
        if vid == section.settings.variant_id
          assign sc_variant = v
          break
        endif
      endfor
    endif
  endif

  assign sc_url = section.settings.link
  if sc_url == blank and sc_product != blank
    if sc_variant != blank
      assign sc_url = sc_product.url | append: '?variant=' | append: sc_variant.id
    else
      assign sc_url = sc_product.url
    endif
  endif
  if sc_url == blank
    assign sc_url = routes.all_products_collection_url
  endif

  assign sc_image = section.settings.image
  if sc_image == blank and sc_variant != blank and sc_variant.featured_image != blank
    assign sc_image = sc_variant.featured_image
  endif
  if sc_image == blank and sc_product != blank
    assign sc_image = sc_product.featured_image
  endif
-%}
<section class="hx-showcase hx-showcase--{{ section.settings.tone }}{% if section.settings.flip %} flip{% endif %}" id="{{ section.settings.anchor | default: section.id }}">
  {%- if section.settings.tone == 'night' and section.settings.show_snow -%}
    <div class="holiday-snow" aria-hidden="true">
      <span>❄</span><span>❅</span><span>❆</span><span>❄</span><span>❅</span><span>❆</span><span>❄</span><span>❅</span>
    </div>
  {%- endif -%}
  <div class="wrap">
    <div class="hx-showcase-grid">
      <div class="hx-showcase-copy reveal">
        {%- if section.settings.eyebrow != blank -%}
          <span class="eyebrow">{{ section.settings.eyebrow }}</span>
        {%- endif -%}
        <h2>{{ section.settings.heading }}</h2>
        {%- if section.settings.text != blank -%}
          <p class="hx-showcase-sub">{{ section.settings.text }}</p>
        {%- endif -%}

        {%- if section.blocks.size > 0 -%}
          <div class="hx-showcase-points">
            {%- for block in section.blocks -%}
              <span {{ block.shopify_attributes }}><i class="hx-dot" aria-hidden="true"></i>{{ block.settings.text }}</span>
            {%- endfor -%}
          </div>
        {%- endif -%}

        <div class="hx-showcase-buy">
          {%- if sc_variant != blank and section.settings.show_price -%}
            <div class="hx-showcase-price">
              {%- if section.settings.price_prefix != blank -%}
                <span class="hx-prefix">{{ section.settings.price_prefix }}</span>
              {%- endif -%}
              <strong>{{ sc_variant.price | money }}</strong>
              {%- if sc_variant.compare_at_price > sc_variant.price -%}
                <s>{{ sc_variant.compare_at_price | money }}</s>
              {%- endif -%}
            </div>
          {%- endif -%}
          <a href="{{ sc_url }}" class="btn btn-primary hx-gold">{{ section.settings.cta_label | default: 'Jetzt entdecken' }}</a>
          {%- if section.settings.cta2_label != blank and section.settings.cta2_link != blank -%}
            <a href="{{ section.settings.cta2_link }}" class="btn btn-ghost hx-more">{{ section.settings.cta2_label }}</a>
          {%- endif -%}
        </div>

        {%- if sc_variant != blank and section.settings.show_stock -%}
          {%- if sc_variant.available -%}
            <div class="hx-showcase-stock">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>
              {{ 'products.product.in_stock' | t }}
            </div>
          {%- endif -%}
        {%- endif -%}
      </div>

      <div class="hx-showcase-media reveal">
        <span class="hx-ring" aria-hidden="true"></span>
        {%- if sc_image != blank -%}
          <img src="{{ sc_image | image_url: width: 920 }}"
               srcset="{{ sc_image | image_url: width: 480 }} 480w, {{ sc_image | image_url: width: 920 }} 920w"
               sizes="(max-width: 960px) 82vw, 460px"
               alt="{{ sc_image.alt | default: sc_product.title | escape }}"
               width="{{ sc_image.width }}" height="{{ sc_image.height }}" loading="lazy">
        {%- endif -%}
        {%- if section.settings.badge_text != blank -%}
          <span class="hx-showcase-badge">{{ section.settings.badge_text }}</span>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Saison-Showcase",
  "settings": [
    { "type": "paragraph", "content": "Editoriale Produktbühne für die Saison. Preis und Bild kommen live vom gewählten Produkt (marktspezifisch). Übersetzbar via Translate & Adapt." },
    {
      "type": "select",
      "id": "tone",
      "label": "Stil",
      "options": [
        { "value": "night", "label": "Winternacht (dunkel)" },
        { "value": "ice", "label": "Eis (hell)" }
      ],
      "default": "night"
    },
    { "type": "checkbox", "id": "flip", "label": "Bild links statt rechts", "default": false },
    { "type": "checkbox", "id": "show_snow", "label": "Schneefall anzeigen (nur dunkel)", "default": true },
    { "type": "text", "id": "anchor", "label": "Anker-ID (optional)" },
    { "type": "header", "content": "Inhalt" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Limitierte Edition" },
    { "type": "html", "id": "heading", "label": "Überschrift", "default": "Der Duft der <span class=\"hg\">Feiertage.</span>" },
    { "type": "textarea", "id": "text", "label": "Text" },
    { "type": "text", "id": "badge_text", "label": "Badge auf dem Bild (optional)" },
    { "type": "header", "content": "Produkt" },
    { "type": "product", "id": "product", "label": "Produkt" },
    { "type": "text", "id": "variant_id", "label": "Varianten-ID (optional)", "info": "Numerische ID der Variante, z. B. für einen bestimmten Duft. Leer = erste verfügbare Variante." },
    { "type": "image_picker", "id": "image", "label": "Eigenes Bild (optional)", "info": "Leer = Produktbild der gewählten Variante." },
    { "type": "checkbox", "id": "show_price", "label": "Preis anzeigen", "default": true },
    { "type": "text", "id": "price_prefix", "label": "Text vor dem Preis", "default": "Nur" },
    { "type": "checkbox", "id": "show_stock", "label": "Verfügbarkeit anzeigen", "default": true },
    { "type": "header", "content": "Buttons" },
    { "type": "text", "id": "cta_label", "label": "Button-Text", "default": "Jetzt entdecken" },
    { "type": "url", "id": "link", "label": "Button-Link (optional)", "info": "Leer = Produktseite der gewählten Variante." },
    { "type": "text", "id": "cta2_label", "label": "Zweiter Button-Text (optional)" },
    { "type": "url", "id": "cta2_link", "label": "Zweiter Button-Link" }
  ],
  "blocks": [
    {
      "type": "point",
      "name": "Merkmal-Chip",
      "settings": [
        { "type": "text", "id": "text", "label": "Text", "default": "Langanhaltender Duft" }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [
    { "name": "Saison-Showcase" }
  ]
}
{% endschema %}
