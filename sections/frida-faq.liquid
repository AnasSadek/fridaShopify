<section class="section-padding">
  <div class="page-width">
    <div class="section-header">
      {%- if section.settings.eyebrow != blank -%}<p class="section-eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
      <h2 class="section-title">{{ section.settings.title | default: 'Häufig gestellte Fragen' }}</h2>
    </div>

    <div class="faq-list">
      {%- for block in section.blocks -%}
        <div class="faq-item" {{ block.shopify_attributes }}>
          <button class="faq-item__q" aria-expanded="false">
            <span>{{ block.settings.question }}</span>
            <span class="faq-item__icon">{% render 'icon', name: 'plus' %}</span>
          </button>
          <div class="faq-item__a">
            <div class="faq-item__a-inner">{{ block.settings.answer }}</div>
          </div>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Frida FAQ",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Kicker-Text", "default": "FAQ" },
    { "type": "text", "id": "title", "label": "Überschrift", "default": "Häufig gestellte Fragen" }
  ],
  "blocks": [
    {
      "type": "faq",
      "name": "Frage",
      "settings": [
        { "type": "text", "id": "question", "label": "Frage", "default": "Wie verwende ich den Bodenduft?" },
        { "type": "richtext", "id": "answer", "label": "Antwort", "default": "<p>Gib einfach eine kleine Menge des Frida Bodendufts in dein Putzwasser und wische Böden oder Oberflächen wie gewohnt. Für einen intensiveren Duft kannst du die Menge leicht erhöhen.</p>" }
      ]
    }
  ],
  "max_blocks": 10,
  "presets": [
    {
      "name": "Frida FAQ",
      "blocks": [
        { "type": "faq", "settings": { "question": "Wie verwende ich den Bodenduft?", "answer": "<p>Gib einfach eine kleine Menge des Frida Bodendufts in dein Putzwasser und wische Böden oder Oberflächen wie gewohnt.</p>" } },
        { "type": "faq", "settings": { "question": "Kann ich die Düfte für verschiedene Räume nutzen?", "answer": "<p>Ja. Frida Lufterfrischer und Bodendüfte eignen sich für Wohnzimmer, Bad, Küche, Büro und Eingangsbereich.</p>" } },
        { "type": "faq", "settings": { "question": "Wie lange hält der Duft?", "answer": "<p>Je nach Raumgröße und Belüftung hält der Frida Duft spürbar lange an und sorgt für eine dauerhaft frische Atmosphäre.</p>" } },
        { "type": "faq", "settings": { "question": "Welche Duftsorten gibt es?", "answer": "<p>Unter anderem Oud, Arabesque, Treasure, Peach, Lavender, Limoncello, Clean und Arabian Jasmine – regelmäßig ergänzt um neue Sorten.</p>" } },
        { "type": "faq", "settings": { "question": "Wie schnell ist der Versand?", "answer": "<p>Bestellungen innerhalb der EU werden schnell und zuverlässig versendet. Die genaue Lieferzeit siehst du im Checkout.</p>" } }
      ]
    }
  ]
}
{% endschema %}
