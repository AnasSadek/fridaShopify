<!doctype html>
<html lang="de">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <meta name="theme-color" content="{{ settings.color_primary }}">
  <title>
    {{ page_title }}{% if page_title contains 'Frida' %}{% else %} &ndash; Frida EU{% endif %}
  </title>

  {% if page_description %}
    <meta name="description" content="{{ page_description | escape }}">
  {% endif %}
  <link rel="canonical" href="{{ canonical_url }}">
  {% render 'meta-tags' %}

  {% if settings.favicon %}
    <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 64 }}">
  {% endif %}

  {{ content_for_header }}

  <style>
    :root{
      --color-primary: {{ settings.color_primary }};
      --color-primary-dark: {{ settings.color_primary_dark }};
      --color-aqua: {{ settings.color_aqua }};
      --color-aqua-light: {{ settings.color_aqua_light }};
      --color-bg: {{ settings.color_background }};
      --color-bg-soft: {{ settings.color_background_soft }};
      --color-text: {{ settings.color_text }};
      --color-text-light: {{ settings.color_text_light }};
      --page-width: {{ settings.page_width }}px;
      --radius: {{ settings.corner_radius }}px;
      --font-heading: {{ settings.font_heading.family }}, {{ settings.font_heading.fallback_families }};
      --font-heading-weight: {{ settings.font_heading.weight }};
      --font-body: {{ settings.font_body.family }}, {{ settings.font_body.fallback_families }};
      --font-body-weight: {{ settings.font_body.weight }};
    }
  </style>
  {{ settings.font_heading | font_face: font_display: 'swap' }}
  {{ settings.font_body | font_face: font_display: 'swap' }}

  {{ 'base.css' | asset_url | stylesheet_tag }}
</head>
<body class="template-{{ request.page_type }}">
  <a class="skip-to-content" href="#MainContent">{{ 'accessibility.skip_to_content' | t }}</a>

  {% section 'header' %}

  <main id="MainContent" role="main">
    {{ content_for_layout }}
  </main>

  {% section 'footer' %}

  <div id="quick-view-root" class="quick-view" hidden aria-hidden="true">
    <div class="quick-view__overlay" data-quick-view-close></div>
    <div class="quick-view__panel" role="dialog" aria-modal="true" aria-label="{{ 'products.product.quick_view' | t }}">
      <button class="quick-view__close" data-quick-view-close aria-label="{{ 'accessibility.close' | t }}">&times;</button>
      <div class="quick-view__content" data-quick-view-content></div>
    </div>
  </div>

  <script src="{{ 'global.js' | asset_url }}" defer="defer"></script>
</body>
</html>
