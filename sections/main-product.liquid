{%- assign product = product -%}
{%- assign current_variant = product.selected_or_first_available_variant -%}

{%- assign current_variant_is_sellable = false -%}
{%- if current_variant.available -%}
  {%- if current_variant.inventory_management == blank or current_variant.inventory_quantity > 0 -%}
    {%- assign current_variant_is_sellable = true -%}
  {%- endif -%}
{%- endif -%}

{%- unless current_variant_is_sellable -%}
  {%- for variant in product.variants -%}
    {%- if variant.available -%}
      {%- if variant.inventory_management == blank or variant.inventory_quantity > 0 -%}
        {%- assign current_variant = variant -%}
        {%- assign current_variant_is_sellable = true -%}
        {%- break -%}
      {%- endif -%}
    {%- endif -%}
  {%- endfor -%}
{%- endunless -%}

{%- assign fallback_product_type = 'products.product.home_fragrance' | t -%}
{%- assign shipping_included = product.metafields.custom.shipping_included.value -%}

<div class="wrap breadcrumb">
  <a href="{{ routes.root_url }}">{{ 'general.navigation.home' | t }}</a> /
  {%- if product.collections.first -%}
    <a href="{{ product.collections.first.url }}">{{ product.collections.first.title }}</a> /
  {%- endif -%}
  <span>{{ product.title }}</span>
</div>

{%- capture pp_raw -%}{%- render 'promo-info', pi_product: product, pi_variant_id: current_variant.id -%}{%- endcapture -%}
{%- assign pp_raw = pp_raw | strip -%}
{%- assign pp_mode = blank -%}
{%- assign pp_price = -1 -%}
{%- if pp_raw != blank -%}
  {%- assign pp_parts = pp_raw | split: '~~' -%}
  {%- assign pp_mode = pp_parts[0] -%}
  {%- assign pp_title = pp_parts[1] -%}
  {%- assign pp_kind = pp_parts[2] -%}
  {%- assign pp_value = pp_parts[3] | plus: 0 -%}
  {%- if pp_mode == 'price' and settings.promo_prices_enabled -%}
    {%- if pp_kind == 'amount' -%}
      {%- assign pp_price = current_variant.price | minus: pp_value -%}
      {%- assign pp_saving = pp_value | money -%}
    {%- else -%}
      {%- assign pp_pct_remain = 100.0 | minus: pp_value -%}
      {%- assign pp_price = current_variant.price | times: pp_pct_remain | divided_by: 100.0 | round -%}
      {%- assign pp_saving = pp_value | append: ' %' -%}
    {%- endif -%}
    {%- if pp_price < 0 -%}{%- assign pp_price = 0 -%}{%- endif -%}
  {%- endif -%}
{%- endif -%}

<section class="pdp">
  <div class="wrap pdp-grid">
    <!-- GALLERY -->
    <div class="gallery">
      <div class="gal-main">
        {%- assign has_gallery_badge = false -%}
        {%- if pp_mode != blank -%}
          {%- assign has_gallery_badge = true -%}
          <span class="gal-flag gal-flag-promo" dir="auto">{{ pp_title }}</span>
        {%- elsif product.compare_at_price > product.price -%}
          {%- assign has_gallery_badge = true -%}
          <span class="gal-flag" style="background:#ff5a6e">{{ 'products.product.sale' | t }}</span>
        {%- elsif product.tags contains 'Bestseller' -%}
          {%- assign has_gallery_badge = true -%}
          <span class="gal-flag">{{ 'products.product.bestseller' | t }}</span>
        {%- endif -%}

        {%- if shipping_included == true -%}
          <span class="gal-flag gal-flag-shipping{% unless has_gallery_badge %} gal-flag-shipping-alone{% endunless %}">
            {{ 'products.product.free_shipping_badge' | t }}
          </span>
        {%- endif -%}

        {%- if product.featured_image -%}
          <img
            id="galImg"
            src="{{ product.featured_image | image_url: width: 900 }}"
            alt="{{ product.featured_image.alt | default: product.title | escape }}"
            width="auto"
            height="auto"
            fetchpriority="high"
          >
        {%- endif -%}
      </div>

      {%- if product.images.size > 1 -%}
        <div class="gal-thumbs">
          {%- for image in product.images limit: 8 -%}
            <div class="gal-thumb {% if forloop.first %}active{% endif %}" data-thumb-src="{{ image | image_url: width: 900 }}">
              <img
                src="{{ image | image_url: width: 200 }}"
                alt="{{ image.alt | default: product.title | escape }}"
                width="auto"
                height="auto"
                loading="lazy"
              >
            </div>
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>

    <!-- INFO -->
    <div class="pdp-info">
      <div class="pdp-cat">{{ product.type | default: fallback_product_type }}</div>
      <h1 class="pdp-title">{{ product.title }}</h1>

      {%- if product.metafields.custom.subtitle != blank -%}
        <p class="pdp-sub">{{ product.metafields.custom.subtitle }}</p>
      {%- endif -%}

      {% comment %} <div class="pdp-rate">
        <span class="s">★★★★★</span>
        <b style="color:var(--ink)">{{ product.metafields.reviews.rating.value | default: 4.9 }}</b>
        <a href="#reviews">{{ product.metafields.reviews.rating_count | default: 120 }} {{ 'products.product.reviews' | t }}</a>
      </div> {% endcomment %}

      <div class="pdp-price">
        {%- if pp_price >= 0 -%}
          <span class="now price-promo" id="pPrice">{{ pp_price | money }}</span>
          <span class="was" id="pWas">{{ current_variant.price | money }}</span>
          <span class="off" id="pOff">−{{ pp_saving }}</span>
        {%- elsif current_variant.compare_at_price > current_variant.price -%}
          <span class="now" id="pPrice">{{ current_variant.price | money }}</span>
          <span class="was" id="pWas">{{ current_variant.compare_at_price | money }}</span>
          <span class="off" id="pOff">
            –{{ current_variant.compare_at_price | minus: current_variant.price | times: 100.0 | divided_by: current_variant.compare_at_price | round }} %
          </span>
        {%- else -%}
          <span class="now" id="pPrice">{{ current_variant.price | money }}</span>
          <span class="was" id="pWas" style="display:none"></span>
          <span class="off" id="pOff" style="display:none"></span>
        {%- endif -%}
      </div>
      <div class="pdp-promo" id="pPromo" dir="auto"{% if pp_mode == blank %} style="display:none"{% endif %}>
        {%- if pp_mode != blank -%}
          <b>{{ pp_title }}</b>
          {%- if pp_price >= 0 -%}
            · {{ 'products.product.you_save' | t: amount: pp_saving }}
          {%- elsif pp_mode == 'partial' -%}
            · {{ 'products.product.promo_select_variants' | t }}
          {%- else -%}
            · {{ 'products.product.promo_in_cart' | t }}
          {%- endif -%}
        {%- endif -%}
      </div>


      <p class="pdp-tax">
        <b id="pAvail">
          {% if current_variant.available %}
            {{ 'products.product.in_stock' | t }}
          {% else %}
            {{ 'products.product.sold_out' | t }}
          {% endif %}
        </b>
        ·
        {%- if shipping_included == true -%}
          {{ 'products.product.tax_shipping_included_html' | t }}
        {%- else -%}
          {{ 'products.product.tax_shipping_extra_html' | t }}
        {%- endif -%}
      </p>

      {%- form 'product', product, id: 'productForm', class: 'frida-add-form' -%}
        {%- unless product.has_only_default_variant -%}
          {%- for option in product.options_with_values -%}
            {%- assign option_index = option.position | minus: 1 -%}
            {%- case option.position -%}
              {%- when 1 -%}
                {%- assign selected_value = current_variant.option1 -%}
              {%- when 2 -%}
                {%- assign selected_value = current_variant.option2 -%}
              {%- when 3 -%}
                {%- assign selected_value = current_variant.option3 -%}
            {%- endcase -%}

            <div class="opt-label">
              {{ option.name }}:
              <span data-opt-display="{{ option_index }}">{{ selected_value }}</span>
            </div>

            <div class="scent-opts" data-option-index="{{ option_index }}">
              {%- for value in option.values -%}
                {%- assign value_available = false -%}

                {%- for variant in product.variants -%}
                  {%- assign variant_is_sellable = false -%}
                  {%- if variant.available -%}
                    {%- if variant.inventory_management == blank or variant.inventory_quantity > 0 -%}
                      {%- assign variant_is_sellable = true -%}
                    {%- endif -%}
                  {%- endif -%}

                  {%- if variant_is_sellable -%}
                    {%- if option.position == 1 and variant.option1 == value -%}
                      {%- assign value_available = true -%}
                    {%- elsif option.position == 2 and variant.option2 == value -%}
                      {%- assign value_available = true -%}
                    {%- elsif option.position == 3 and variant.option3 == value -%}
                      {%- assign value_available = true -%}
                    {%- endif -%}
                  {%- endif -%}

                  {%- if value_available -%}
                    {%- break -%}
                  {%- endif -%}
                {%- endfor -%}

                {%- unless value_available -%}
                  {%- continue -%}
                {%- endunless -%}

                <button
                  type="button"
                  class="scent-opt {% if selected_value == value %}active{% endif %}"
                  data-option-value
                  data-value="{{ value | escape }}"
                >
                  {{ value }}
                </button>
              {%- endfor -%}
            </div>
          {%- endfor -%}
        {%- endunless -%}

        <input type="hidden" name="id" id="variantId" value="{{ current_variant.id }}">
        <input type="hidden" name="properties[_localized_product_title]" value="{{ product.title | escape }}">

        {%- unless current_variant.title contains 'Default' -%}
          <input type="hidden" name="properties[_localized_variant_title]" id="localizedVariantTitle" value="{{ current_variant.title | escape }}">
        {%- endunless -%}

        {%- if shipping_included == true -%}
          <input type="hidden" name="properties[_shipping_included]" value="true">
        {%- endif -%}

        <div class="buy-row">
          <div class="qty-box">
            <button type="button" id="qMinus" aria-label="{{ 'products.product.quantity_minus' | t }}">−</button>
            <input
              type="text"
              name="quantity"
              id="qVal"
              value="1"
              inputmode="numeric"
              style="width:34px;text-align:center;border:none;font-weight:700;font-family:inherit"
            >
            <button type="button" id="qPlus" aria-label="{{ 'products.product.quantity_plus' | t }}">+</button>
          </div>

          <button type="submit" class="btn btn-primary" id="pAdd" {% unless current_variant.available %}disabled{% endunless %}>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4Z"/>
              <path d="M3 6h18"/>
              <path d="M16 10a4 4 0 0 1-8 0"/>
            </svg>
            <span id="pAddLabel">{% if current_variant.available %}{{ 'products.product.add_to_cart' | t }}{% else %}{{ 'products.product.sold_out' | t }}{% endif %}</span>
          </button>
        </div>
      {%- endform -%}

      <div class="assure">
        <div><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="1" y="3" width="15" height="13" rx="2"/><path d="M16 8h4l3 3v5h-7z"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg><div><b>{{ 'cart.general.fast_shipping' | t }}</b><small>{% if shipping_included == true %}{{ 'products.product.shipping_included_short' | t }}{% else %}{{ 'products.product.shipping_extra_short' | t }}{% endif %}</small></div></div>
        <div><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 12l2 2 4-4"/><path d="M12 3l7 3v6c0 4-3 7-7 9-4-2-7-5-7-9V6z"/></svg><div><b>{{ 'cart.general.secure_payment' | t }}</b><small>{{ 'products.product.payment_methods' | t }}</small></div></div>
        <div><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 12a9 9 0 1 0 18 0 9 9 0 0 0-18 0"/><path d="M12 7v5l3 2"/></svg><div><b>{{ 'products.product.freshness_title' | t }}</b><small>{{ 'products.product.freshness_text' | t }}</small></div></div>
        <div><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 12v7a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2v-7"/><path d="M2 7h20v5H2z"/><path d="M12 22V7M12 7S9 2 6.5 4.5 12 7 12 7z"/></svg><div><b>{{ 'products.product.returns_title' | t }}</b><small>{{ 'products.product.returns_text' | t }}</small></div></div>
      </div>
    </div>
  </div>
</section>

<!-- DETAILS -->
<section class="wrap pdp-details">
  <div class="detail-tabs">
    <button class="detail-tab active" data-tab="desc">{{ 'products.product.description' | t }}</button>
    <button class="detail-tab" data-tab="use">{{ 'products.product.usage' | t }}</button>
    <button class="detail-tab" data-tab="ben">{{ 'products.product.benefits' | t }}</button>
    <button class="detail-tab" data-tab="ship">{{ 'products.product.shipping' | t }}</button>
  </div>

  <div class="tab-panel active" data-panel="desc">
    <div class="rte">{{ product.description }}</div>
  </div>

  <div class="tab-panel" data-panel="use" id="versand-use">
    <div class="rte">{{ section.settings.usage_text }}</div>
  </div>

  <div class="tab-panel" data-panel="ben">
    <div class="rte">{{ section.settings.benefits_text }}</div>
  </div>

  <div class="tab-panel" data-panel="ship" id="versand">
    <div class="rte">{{ section.settings.shipping_text }}</div>
  </div>
</section>

<!-- RELATED -->
{%- assign related = product.collections.first.products | default: collections.all.products -%}
{%- if related.size > 1 -%}
  <section class="section related" id="related" style="background:var(--mist-2)">
    <div class="wrap">
      <div class="section-head reveal">
        <span class="eyebrow">{{ 'products.product.related_eyebrow' | t }}</span>
        <h2>{{ 'products.product.related_title' | t }}</h2>
      </div>

      <div class="grid-prod">
        {%- assign shown = 0 -%}
        {%- for p in related -%}
          {%- if p.id != product.id and shown < 4 -%}
            {%- render 'product-card', card: p -%}
            {%- assign shown = shown | plus: 1 -%}
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>
  </section>
{%- endif -%}

<!-- STICKY ADD TO CART -->
<div class="sticky-bar" id="stickyBar">
  <div class="wrap sticky-inner">
    <div class="sticky-prod">
      {%- if product.featured_image -%}
        <img
          src="{{ product.featured_image | image_url: width: 120 }}"
          alt="{{ product.featured_image.alt | default: product.title | escape }}"
          width="auto"
          height="auto"
          loading="lazy"
        >
      {%- endif -%}
      <div class="sp-hide">
        <b>{{ product.title }}</b>
        <small>{{ product.type }}</small>
      </div>
    </div>

    <div class="sticky-price" id="sbPrice">
      {%- if pp_price >= 0 -%}
        {{ pp_price | money }}
        <s>{{ current_variant.price | money }}</s>
      {%- else -%}
        {{ current_variant.price | money }}
        {% if current_variant.compare_at_price > current_variant.price %}
          <s>{{ current_variant.compare_at_price | money }}</s>
        {% endif %}
      {%- endif -%}
    </div>

    <button class="btn btn-primary" id="sbAdd" {% unless current_variant.available %}disabled{% endunless %}>
      {{ 'products.product.add_to_cart' | t }}
    </button>
  </div>
</div>

<script id="ProductJson" type="application/json">
[
  {%- for variant in product.variants -%}
    {%- assign variant_is_sellable = false -%}
    {%- if variant.available -%}
      {%- if variant.inventory_management == blank or variant.inventory_quantity > 0 -%}
        {%- assign variant_is_sellable = true -%}
      {%- endif -%}
    {%- endif -%}
    {
      "id": {{ variant.id | json }},
      "title": {{ variant.title | json }},
      "available": {{ variant_is_sellable | json }},
      "price": {{ variant.price | json }},
      "compare_at_price": {{ variant.compare_at_price | json }},
      "options": {{ variant.options | json }},
      "image": {%- if variant.featured_image -%}
        {{ variant.featured_image | image_url: width: 900 | json }}
      {%- elsif product.featured_image -%}
        {{ product.featured_image | image_url: width: 900 | json }}
      {%- else -%}
        null
      {%- endif -%},
      "imageAlt": {%- if variant.featured_image and variant.featured_image.alt != blank -%}
        {{ variant.featured_image.alt | json }}
      {%- else -%}
        {{ product.title | json }}
      {%- endif -%},
      {%- capture vp_raw -%}{%- render 'promo-info', pi_product: product, pi_variant_id: variant.id -%}{%- endcapture -%}
      {%- assign vp_raw = vp_raw | strip -%}
      {%- assign vp_price = -1 -%}
      {%- assign vp_mode = '' -%}
      {%- assign vp_title = '' -%}
      {%- assign vp_saving = '' -%}
      {%- if vp_raw != blank -%}
        {%- assign vp_parts = vp_raw | split: '~~' -%}
        {%- assign vp_mode = vp_parts[0] -%}
        {%- assign vp_title = vp_parts[1] -%}
        {%- assign vp_kind = vp_parts[2] -%}
        {%- assign vp_value = vp_parts[3] | plus: 0 -%}
        {%- if vp_mode == 'price' and settings.promo_prices_enabled -%}
          {%- if vp_kind == 'amount' -%}
            {%- assign vp_price = variant.price | minus: vp_value -%}
            {%- assign vp_saving = vp_value | money -%}
          {%- else -%}
            {%- assign vp_pct_remain = 100.0 | minus: vp_value -%}
            {%- assign vp_price = variant.price | times: vp_pct_remain | divided_by: 100.0 | round -%}
            {%- assign vp_saving = vp_value | append: ' %' -%}
          {%- endif -%}
          {%- if vp_price < 0 -%}{%- assign vp_price = 0 -%}{%- endif -%}
        {%- endif -%}
      {%- endif -%}
      "promo_mode": {{ vp_mode | json }},
      "promo_title": {{ vp_title | json }},
      "promo_price": {% if vp_price >= 0 %}{{ vp_price | json }}{% else %}null{% endif %},
      "promo_saving": {{ vp_saving | json }}
    }{%- unless forloop.last -%},{%- endunless -%}
  {%- endfor -%}
]
</script>

{% schema %}
{
  "name": "Produkt",
  "settings": [
    {
      "type": "richtext",
      "id": "usage_text",
      "label": "Anwendung",
      "default": "<p>Gib 1–2 Verschlusskappen auf ca. 5 L warmes Wasser und reinige Böden und abwaschbare Oberflächen wie gewohnt. Vor der ersten Anwendung an unauffälliger Stelle testen.</p>"
    },
    {
      "type": "richtext",
      "id": "benefits_text",
      "label": "Vorteile",
      "default": "<p>Langanhaltender Duft, viele Duftsorten, für Zuhause & Büro, einfache Anwendung und eine frische Atmosphäre – Frida macht dein Zuhause spürbar sauberer.</p>"
    },
    {
      "type": "richtext",
      "id": "shipping_text",
      "label": "Versand",
      "default": "<p>Versand in 2–4 Werktagen (DE) bzw. 3–6 Werktagen (EU). Versandkosten 3,90 € – gratis ab 39 €. 14 Tage Rückgaberecht.</p>"
    }
  ]
}
{% endschema %}
