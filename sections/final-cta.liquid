<section class="section" id="finale" style="padding-top:0">
  <div class="wrap">
    <div class="final-cta reveal">
      {%- if section.settings.eyebrow != blank -%}<span class="eyebrow" style="color:#bfe6fb">{{ section.settings.eyebrow }}</span>{%- endif -%}
      <h2>{{ section.settings.heading }}</h2>
      {%- if section.settings.text != blank -%}<p>{{ section.settings.text }}</p>{%- endif -%}
      <a href="{{ section.settings.button_link | default: '#bestseller' }}" class="btn btn-primary">{{ section.settings.button_label }}
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M13 5l7 7-7 7"/></svg>
      </a>
      <div class="fc-note">
        {%- assign notes = section.settings.notes | split: ',' -%}
        {%- for n in notes -%}
          <span><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 13l4 4L19 7"/></svg>{{ n | strip }}</span>
        {%- endfor -%}
      </div>
    </div>
  </div>
</section>

{%- if section.settings.mobile_bar and request.page_type == 'index' -%}
  <div class="home-sticky" id="homeSticky">
    <a href="{{ section.settings.button_link | default: '#bestseller' }}">
      {{ section.settings.mobile_bar_label | default: section.settings.button_label }}
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M13 5l7 7-7 7"/></svg>
    </a>
  </div>
{%- endif -%}
{% schema %}
{
  "name": "Finaler CTA",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Bereit?" },
    { "type": "text", "id": "heading", "label": "Überschrift", "default": "Bereit für ein Zuhause, das frischer riecht?" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Über 12.000 Haushalte vertrauen auf Frida. Finde jetzt den Duft, der zu dir passt." },
    { "type": "text", "id": "button_label", "label": "Button", "default": "Jetzt Lieblingsduft finden" },
    { "type": "url", "id": "button_link", "label": "Button-Link" },
    { "type": "text", "id": "notes", "label": "Vertrauens-Hinweise (Komma-getrennt)", "default": "Schneller Versand, Sichere Bezahlung, Viele Duftsorten" },
    { "type": "header", "content": "Mobiler Sticky-Button (nur Startseite)" },
    { "type": "checkbox", "id": "mobile_bar", "label": "Sticky-CTA auf Mobilgeräten anzeigen", "default": true },
    { "type": "text", "id": "mobile_bar_label", "label": "Sticky-CTA Text", "default": "Jetzt Düfte entdecken" }
  ],
  "presets": [ { "name": "Finaler CTA" } ]
}
{% endschema %}
