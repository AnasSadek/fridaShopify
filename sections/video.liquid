<section class="section" id="video">
  <div class="wrap">
    <div class="video-wrap reveal" {% if section.settings.video_url != blank %}data-video="{{ section.settings.video_url }}"{% endif %}>
      <span class="video-tag">▶ {{ section.settings.tag | default: 'Lifestyle-Video' }}</span>
      <div class="video-inner">
        <button class="play" id="playBtn" aria-label="Video abspielen"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg></button>
        <h2>{{ section.settings.heading }}</h2>
        {%- if section.settings.text != blank -%}<p>{{ section.settings.text }}</p>{%- endif -%}
        {%- if section.settings.button_label != blank -%}<a href="{{ section.settings.button_link | default: '#' }}" class="btn btn-ghost">{{ section.settings.button_label }}</a>{%- endif -%}
      </div>
    </div>
  </div>
</section>
{% schema %}
{
  "name": "Video",
  "settings": [
    { "type": "text", "id": "tag", "label": "Badge", "default": "Lifestyle-Video" },
    { "type": "text", "id": "heading", "label": "Überschrift", "default": "So einfach bringst du Frida-Frische in dein Zuhause" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Ein Sprühstoß, ein Wisch – und der ganze Raum fühlt sich neu an." },
    { "type": "url", "id": "video_url", "label": "Video-URL (YouTube/Vimeo/MP4)" },
    { "type": "text", "id": "button_label", "label": "Button", "default": "Produkte entdecken" },
    { "type": "url", "id": "button_link", "label": "Button-Link" }
  ],
  "presets": [ { "name": "Video" } ]
}
{% endschema %}
