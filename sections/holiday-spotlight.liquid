{%- comment -%}
  Holiday Spotlight – saisonaler Weihnachts-/Neujahrs-Hero (Frida EU)
  - Nutzt das echte Shopify-Produkt (Preis/Verfügbarkeit marktabhängig via Liquid)
  - Optionale Varianten-ID (z. B. Weihnachtsduft "Vanilla and Cinnamon")
  - Optionales eigenes Hero-Bild; sonst Variantenbild, sonst Produktbild
  - Deaktivierbar über das Auge-Symbol im Theme-Editor (Seasonal Mode)
{%- endcomment -%}

{%- liquid
  assign hs_product = section.settings.product
  assign hs_variant = blank
  if hs_product != blank
    assign hs_variant = hs_product.selected_or_first_available_variant
    assign want_id = section.settings.variant_id | strip
    if want_id != blank
      for v in hs_product.variants
        assign vid = v.id | append: ''
        if vid == want_id
          assign hs_variant = v
          break
        endif
      endfor
    endif
  endif

  assign hs_url = section.settings.button_link
  if hs_url == blank and hs_product != blank
    if hs_variant != blank and hs_product.variants.size > 1
      assign hs_url = hs_product.url | append: '?variant=' | append: hs_variant.id
    else
      assign hs_url = hs_product.url
    endif
  endif
  if hs_url == blank
    assign hs_url = routes.all_products_collection_url
  endif

  assign hs_image = section.settings.image
  if hs_image == blank and hs_variant != blank and hs_variant.featured_image != blank
    assign hs_image = hs_variant.featured_image
  endif
  if hs_image == blank and hs_product != blank
    assign hs_image = hs_product.featured_image
  endif
-%}

<section class="hero hero-offer-v2 holiday-hero" id="weihnachten">
  {%- if section.settings.show_snow -%}
    <div class="holiday-snow" aria-hidden="true">
      <span>❅</span><span>❆</span><span>❅</span><span>✦</span><span>❆</span><span>❅</span><span>✦</span><span>❆</span><span>❅</span><span>❆</span>
    </div>
  {%- endif -%}

  <div class="wrap hero-v2-grid">
    <div class="hero-copy hero-v2-copy">
      {%- if section.settings.eyebrow != blank -%}
        <span class="eyebrow hero-v2-eyebrow holiday-eyebrow">{{ section.settings.eyebrow }}</span>
      {%- endif -%}

      {%- if section.settings.heading != blank -%}
        <h1 class="hero-v2-title">{{ section.settings.heading }}</h1>
      {%- endif -%}

      {%- if section.settings.deal_line != blank -%}
        <p class="hero-v2-deal holiday-deal">{{ section.settings.deal_line }}</p>
      {%- endif -%}

      {%- if section.settings.subheading != blank -%}
        <p class="hero-sub hero-v2-sub">{{ section.settings.subheading }}</p>
      {%- endif -%}

      {%- if hs_variant != blank or section.settings.price_label != blank or section.settings.shipping_text != blank -%}
        <div class="hero-v2-offer-card holiday-offer-card">
          {%- if hs_variant != blank or section.settings.price_label != blank -%}
            <div class="hero-v2-price">
              {%- if section.settings.price_prefix != blank -%}
                <span class="hero-v2-price-prefix">{{ section.settings.price_prefix }}</span>
              {%- endif -%}
              <strong class="hero-v2-price-value">
                {%- if hs_variant != blank -%}
                  {{ hs_variant.price | money }}
                {%- else -%}
                  {{ section.settings.price_label }}
                {%- endif -%}
              </strong>
              {%- if hs_variant != blank and hs_variant.compare_at_price > hs_variant.price -%}
                <s class="holiday-compare">{{ hs_variant.compare_at_price | money }}</s>
              {%- endif -%}
            </div>
          {%- endif -%}

          {%- if hs_variant != blank -%}
            <div class="holiday-stock{% unless hs_variant.available %} is-out{% endunless %}">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M5 13l4 4L19 7"/></svg>
              <span>{% if hs_variant.available %}{{ 'products.product.in_stock' | t }}{% else %}{{ 'products.product.sold_out' | t }}{% endif %}</span>
            </div>
          {%- endif -%}

          {%- if section.settings.shipping_text != blank -%}
            <div class="hero-v2-shipping">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <rect x="1" y="3" width="15" height="13" rx="2"/>
                <path d="M16 8h4l3 3v5h-7z"/>
                <circle cx="5.5" cy="18.5" r="2.5"/>
                <circle cx="18.5" cy="18.5" r="2.5"/>
              </svg>
              <span>{{ section.settings.shipping_text }}</span>
            </div>
          {%- endif -%}
        </div>
      {%- endif -%}

      <div class="hero-cta hero-v2-cta">
        {%- if section.settings.button_label != blank -%}
          <a href="{{ hs_url }}" class="btn btn-primary holiday-btn">
            {{ section.settings.button_label }}
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path d="M5 12h14M13 5l7 7-7 7"/>
            </svg>
          </a>
        {%- endif -%}

        {%- if section.settings.button2_label != blank -%}
          <a href="{{ section.settings.button2_link | default: '#neu' }}" class="btn btn-ghost hero-v2-more holiday-btn-ghost">
            {{ section.settings.button2_label }}
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path d="M5 12h14M13 5l7 7-7 7"/>
            </svg>
          </a>
        {%- endif -%}
      </div>

      {%- if section.blocks.size > 0 -%}
        <div class="hero-badges holiday-badges">
          {%- for block in section.blocks -%}
            <span {{ block.shopify_attributes }}>
              {%- case block.settings.icon -%}
                {%- when 'snow' -%}
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M12 2v20M4 6l16 12M20 6 4 18M12 2l-2 3h4zM12 22l-2-3h4zM4 6l3.5.5L7 10zM20 18l-3.5-.5.5-3.5zM20 6l-.5 3.5L16 9zM4 18l3.5-.5L7 14z"/></svg>
                {%- when 'gift' -%}
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="3" y="8" width="18" height="4"/><path d="M12 8v13M5 12v9h14v-9"/><path d="M12 8c-1.5-3-5-3.5-5-1s3.5 1 5 1Zm0 0c1.5-3 5-3.5 5-1s-3.5 1-5 1Z"/></svg>
                {%- when 'star' -%}
                  <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="m12 2.5 2.9 5.9 6.5.9-4.7 4.6 1.1 6.5L12 17.3l-5.8 3.1 1.1-6.5-4.7-4.6 6.5-.9L12 2.5Z"/></svg>
                {%- when 'truck' -%}
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="1" y="3" width="15" height="13" rx="2"/><path d="M16 8h4l3 3v5h-7z"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>
                {%- else -%}
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg>
              {%- endcase -%}
              {{ block.settings.text }}
            </span>
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>

    <div class="hero-media hero-v2-media holiday-media">
      <div class="holiday-glow" aria-hidden="true"></div>
      {%- if hs_image != blank -%}
        <img
          src="{{ hs_image | image_url: width: 1000 }}"
          alt="{{ hs_image.alt | default: section.settings.heading | strip_html | escape }}"
          width="{{ hs_image.width | at_most: 1000 }}"
          height="{{ hs_image.width | at_most: 1000 | divided_by: hs_image.aspect_ratio | round }}"
          fetchpriority="high"
        >
      {%- else -%}
        <img
          src="{{ 'Hero.png' | asset_url }}"
          alt="Frida Duftpaket"
          width="1000"
          height="1000"
          fetchpriority="high"
        >
      {%- endif -%}

      {%- if section.settings.show_limited_badge -%}
        <div class="hero-offer-badge hero-v2-badge holiday-limited">
          <strong>❆</strong>
          <span>{% if section.settings.limited_badge_text != blank %}{{ section.settings.limited_badge_text }}{% else %}{{ 'holiday.limited_badge' | t }}{% endif %}</span>
        </div>
      {%- endif -%}
    </div>
  </div>

  <svg class="wave-sep" viewBox="0 0 1440 70" preserveAspectRatio="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><path d="M0,40 C240,75 480,10 720,32 C960,54 1200,72 1440,36 L1440,70 L0,70 Z" fill="#ffffff"/></svg>
</section>

{% schema %}
{
  "name": "Weihnachts-Hero",
  "settings": [
    { "type": "paragraph", "content": "Saisonaler Hero für Weihnachten & Neujahr. Zum Deaktivieren nach der Saison: im Theme-Editor über das Auge-Symbol ausblenden und den Standard-Hero wieder einblenden." },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "❄ Frida Weihnachtsedition" },
    { "type": "html", "id": "heading", "label": "Überschrift", "default": "Dein Zuhause duftet<br>nach <span class=\"hg\">Weihnachten.</span>" },
    { "type": "text", "id": "deal_line", "label": "Angebotszeile", "default": "Vanilla & Cinnamon – der Winterduft für festliche Momente" },
    { "type": "textarea", "id": "subheading", "label": "Untertitel", "default": "Warmer Vanille-Zimt-Duft für Wohnzimmer, Flur & Co. – langanhaltend, festlich und sofort gemütlich." },
    { "type": "header", "content": "Produkt" },
    { "type": "product", "id": "product", "label": "Weihnachtsprodukt" },
    { "type": "text", "id": "variant_id", "label": "Varianten-ID (optional)", "info": "Für einen Weihnachtsduft als Variante (z. B. Vanilla and Cinnamon): Varianten-ID aus dem Produkt-Admin eintragen. Preis, Bild und Link folgen dann dieser Variante." },
    { "type": "image_picker", "id": "image", "label": "Eigenes Hero-Bild (optional)", "info": "Leer = Variantenbild bzw. Produktbild" },
    { "type": "header", "content": "Preis / Versand" },
    { "type": "text", "id": "price_prefix", "label": "Preis-Präfix", "default": "Nur" },
    { "type": "text", "id": "price_label", "label": "Fallback-Preis (ohne Produkt)" },
    { "type": "text", "id": "shipping_text", "label": "Versandtext", "default": "Lieferung in 2–4 Tagen" },
    { "type": "header", "content": "Buttons" },
    { "type": "text", "id": "button_label", "label": "Button 1", "default": "Weihnachtsduft entdecken" },
    { "type": "url", "id": "button_link", "label": "Link 1 (leer = Produkt/Variante)" },
    { "type": "text", "id": "button2_label", "label": "Button 2", "default": "Alle Neuheiten ansehen" },
    { "type": "url", "id": "button2_link", "label": "Link 2 (leer = Neuheiten-Sektion)" },
    { "type": "header", "content": "Dekoration" },
    { "type": "checkbox", "id": "show_snow", "label": "Dezente Schneeflocken anzeigen", "default": true },
    { "type": "checkbox", "id": "show_limited_badge", "label": "Badge am Produktbild anzeigen", "default": true },
    { "type": "text", "id": "limited_badge_text", "label": "Badge-Text (leer = „Limitierte Edition“ übersetzt)" }
  ],
  "blocks": [
    {
      "type": "badge",
      "name": "Vorteil",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "default": "snow",
          "options": [
            { "value": "snow", "label": "Schneeflocke" },
            { "value": "gift", "label": "Geschenk" },
            { "value": "star", "label": "Stern" },
            { "value": "truck", "label": "Versand" },
            { "value": "clock", "label": "Uhr" }
          ]
        },
        { "type": "text", "id": "text", "label": "Text", "default": "Festlicher Winterduft" }
      ]
    }
  ],
  "max_blocks": 5,
  "presets": [
    {
      "name": "Weihnachts-Hero",
      "blocks": [
        { "type": "badge", "settings": { "icon": "snow", "text": "Festlicher Winterduft" } },
        { "type": "badge", "settings": { "icon": "clock", "text": "Bis zu 48h Duft" } },
        { "type": "badge", "settings": { "icon": "gift", "text": "Ideal als Geschenk" } },
        { "type": "badge", "settings": { "icon": "truck", "text": "Schneller Versand" } }
      ]
    }
  ]
}
{% endschema %}
